# Alibaba Cloud DashScope API key
# Obtain from: https://dashscope.console.aliyun.com/ (Singapore region)
#           or https://dashscope-intl.aliyuncs.com  (international)
DASHSCOPE_API_KEY=your_api_key_here

# Optional: override the WebSocket endpoint (e.g. switch to Beijing region)
# DASHSCOPE_WS_URL=wss://dashscope.aliyuncs.com/api-ws/v1/realtime
